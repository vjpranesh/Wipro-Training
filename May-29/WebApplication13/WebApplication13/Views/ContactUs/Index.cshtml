<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Us - Employee Management System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f7f8;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 700px;
            background: white;
            margin: 50px auto;
            padding: 30px 40px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 30px;
        }

        .contact-info {
            margin-bottom: 30px;
            font-size: 16px;
            color: #555;
        }

            .contact-info p {
                margin: 8px 0;
            }

            .contact-info strong {
                color: #222;
            }

        form .form-row {
            display: flex;
            margin-bottom: 25px; /* Increased space between rows */
            align-items: flex-start;
            gap: 10px; /* Space between label and input */
        }

            form .form-row label {
                flex: 0 0 120px;
                font-weight: bold;
                margin-top: 10px;
            }

            form .form-row input,
            form .form-row textarea {
                flex: 1;
                padding: 10px;
                font-size: 16px;
                border: 1px solid #ccc;
                border-radius: 4px;
            }

            form .form-row textarea {
                resize: vertical;
            }

        form button {
            margin-top: 10px;
            background-color: #007BFF;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }

            form button:hover {
                background-color: #0056b3;
            }

        
    </style>
</head>
<body>
    <div class="container">
        <h2>Contact Us</h2>

        <div class="contact-info">
            <p><strong>Management Email:</strong> management@ems.com</p>
            <p><strong>Contact Number:</strong> +1 (555) 123-4567</p>
        </div>

        <form action="#" method="post">
            <div class="form-row">
                <label for="name">Your Name:</label>
                <input type="text" id="name" name="name" required />
            </div>

            <div class="form-row">
                <label for="email">Your Email:</label>
                <input type="email" id="email" name="email" required />
            </div>

            <div class="form-row">
                <label for="subject">Subject:</label>
                <input type="text" id="subject" name="subject" required />
            </div>

            <div class="form-row">
                <label for="message">Message:</label>
                <textarea id="message" name="message" rows="5" required></textarea>
            </div>

            <button type="submit">Send Message</button>
        </form>
    </div>
</body>
</html>
